# Havia mais variáveis de ambiente aqui.
# Entre elas, o e-mail e a chave do aplicativo para envio de notificações.
# Porém, essas configurações agora são definidas na aplicação.

# Chave secreta do Flask.
# Gere uma chave aleatória segura para uso em produção.
SECRET_KEY=your-secret-key-here

# Porta em que a aplicação será executada.
PORT=5000

# Ativa ou desativa o modo de depuração.
# Valores possíveis: True ou False
FLASK_DEBUG=False